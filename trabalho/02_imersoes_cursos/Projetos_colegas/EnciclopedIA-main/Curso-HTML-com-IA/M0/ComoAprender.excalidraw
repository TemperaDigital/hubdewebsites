    {
      "type": "text",
      "version": 1458,
      "versionNonce": 587879493,
      "isDeleted": false,
      "id": "UrTFIBBTyhijLNOKq8gdH",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2125.9800755324213,
      "y": -3440.0914492158245,
      "strokeColor": "#1e1e1e",
